# Copy to .env and edit.  .env is gitignored.

# ---------------------------------------------------------------- run mode
# local      -> open-source Spark on this machine, Delta tables in ./warehouse
# databricks -> Databricks Connect session against the workspace
RETAILPULSE_MODE=local

# ---------------------------------------------------------------- catalog
# Local mode uses Spark's built-in catalog.  Databricks Free Edition normally
# exposes a Unity Catalog named `workspace`.
RETAILPULSE_CATALOG=spark_catalog
RETAILPULSE_SCHEMA=retail_fresher
RETAILPULSE_VOLUME=retail_raw

# ---------------------------------------------------------------- local paths
# Both of these already match the defaults in config.py -- set them only if you
# move the CSVs or want the Delta tables somewhere other than project_2/warehouse.
# Relative paths resolve against project_2/, not your shell's directory.
RETAILPULSE_LOCAL_RAW=../retailpulse-pyspark-sparksql-kafka-airflow-case-study/datasets
RETAILPULSE_LOCAL_WAREHOUSE=./warehouse

# ---------------------------------------------------------------- databricks
# Used by databricks-connect and databricks-sdk.  Create a PAT in the workspace
# under Settings -> Developer -> Access tokens.
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi...
# Leave blank to use serverless compute (Free Edition is serverless-only).
DATABRICKS_CLUSTER_ID=
# Job id created in the workspace, referenced by the Airflow DAG.
DATABRICKS_JOB_ID=

# ---------------------------------------------------------------- kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=retail-sales-summary
KAFKA_CONSUMER_GROUP=retailpulse-consumer
CONSUMED_EVENTS_PATH=./output/consumed_events.jsonl
